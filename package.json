{
  "name": "dsh-wsl-bridge",
  "version": "0.4.6",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./wsl-world": "./wsl-world.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2"
  },
  "files": [
    "index.js",
    "wsl-world.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "scripts/*.ps1",
    "docs/ARCHITECTURE.md",
    "docs/SECURITY.md",
    "docs/TROUBLESHOOTING.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TGWgulugu/dsh-wsl-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/TGWgulugu/dsh-wsl-bridge/issues"
  },
  "homepage": "https://github.com/TGWgulugu/dsh-wsl-bridge#readme",
  "description": "Native WSL execution for DeepSeek Harness on Windows: persistent Linux bash, Linux-path file and search tools, and a declarative WSL session mode. No extra web server and nothing to install inside the distribution.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wsl",
    "windows",
    "linux",
    "bash",
    "workspace"
  ],
  "scripts": {
    "test": "node test/protocol.test.js && node test/shell.test.js && node test/tools.test.js && node test/world-tools.test.js && node test/guard.test.js && node test/jobs.test.js && node test/fsops.test.js",
    "test:integration": "node test/integration.test.js"
  }
}
